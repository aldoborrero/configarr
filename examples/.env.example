# Copy this file to `.env` next to your configarr.yml.
# configarr auto-loads a .env from the config's directory before expanding
# ${VAR} references. Existing process environment variables take precedence.

RADARR_API_KEY=changeme
RADARR_4K_API_KEY=changeme
SONARR_API_KEY=changeme
PROWLARR_API_KEY=changeme
BAZARR_API_KEY=changeme
SABNZBD_API_KEY=changeme

# Download client / indexer / provider secrets referenced by the examples
QBIT_PASSWORD=changeme
TRACKER_API_KEY=changeme
DISCORD_WEBHOOK=https://discord.com/api/webhooks/...
OST_USER=changeme
OST_PASSWORD=changeme
USENET_USER=changeme
USENET_PASSWORD=changeme
